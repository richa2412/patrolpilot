---
import SolutionPage from '@/components/SolutionPage.astro';
---

<SolutionPage
  metaTitle="Security Rostering Software | USA, Canada, UK, UAE, Singapore | PatrolPilot"
  metaDesc="Automate your security roster with intelligent scheduling, compliance checks, and real-time guard notifications. Built for security companies globally."
  eyebrow="Rostering"
  heroTitle="Security Rostering Software"
  heroEm="For global security teams."
  heroSub="Automate your security roster with intelligent scheduling, compliance checks, and real-time guard notifications — all from one platform."
  intro="PatrolPilot's security rostering software is designed for security companies managing complex, multi-site rosters in the USA, Canada, UK, UAE and Singapore. Whether you're running 5 guards or 500, PatrolPilot handles the complexity so your operations team can focus on what matters."
  features={[
    {
      title: 'Intelligent Roster Builder',
      desc: 'Smart suggestions based on guard availability, site requirements and licence validity. Build compliant rosters faster than ever with drag-and-drop simplicity.',
      icon: 'M3 4h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V6a2 2 0 012-2z',
    },
    {
      title: 'Award Rate & Overtime Compliance',
      desc: 'Configure penalty rates, overtime rules and employment conditions. PatrolPilot flags schedule changes that would trigger additional costs.',
      icon: 'M12 2v20M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6',
    },
    {
      title: 'Availability Management',
      desc: 'Guards set their availability in the app. Managers see real-time availability when building rosters, reducing back-and-forth communication.',
      icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
    },
    {
      title: 'Roster Publishing',
      desc: 'Publish rosters for the week or month ahead. Guards receive notifications and can confirm or request changes directly through the app.',
      icon: 'M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9',
    },
    {
      title: 'Timesheet Automation',
      desc: 'Timesheets generated automatically from GPS-verified clock-in/out data. Export to payroll in one click — no manual entry required.',
      icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    },
    {
      title: 'Roster Reporting',
      desc: 'Generate roster reports, labour cost summaries and guard utilisation analytics for management review and client billing.',
      icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
    },
  ]}
  faqs={[
    {
      q: 'Does PatrolPilot support complex multi-site rosters?',
      a: 'Yes. PatrolPilot is designed for multi-site operations. You can manage rosters across unlimited sites, filter by site or region, and view all guards in one consolidated view.',
    },
    {
      q: 'Can I integrate with our payroll system?',
      a: 'PatrolPilot integrates with ADP, QuickBooks, Xero and Sage. Timesheets are exported automatically after each pay period, eliminating manual data entry.',
    },
    {
      q: 'How does PatrolPilot handle last-minute no-shows?',
      a: 'Managers receive instant alerts if a guard fails to clock in. The platform shows available replacement guards with valid licences so you can reassign quickly.',
    },
    {
      q: 'Does the rostering software work across different time zones?',
      a: 'Yes. PatrolPilot is built for global teams and handles multiple time zones seamlessly, making it ideal for security companies with operations across the USA, UK, UAE and Singapore.',
    },
  ]}
/>
