---
/**
 * blog/[slug].astro
 * Dynamic route — generates one page per WordPress post
 * Fetches all posts at build time via getStaticPaths()
 */
import Layout from '@/layouts/Layout.astro';
import { getAllPosts, getPostBySlug, getRelatedPosts, getImageUrl, formatDate, readingTime, stripHtml } from '@/lib/wordpress';
import type { WPPost } from '@/lib/wordpress';

export async function getStaticPaths() {
  try {
    // Fetch all posts for static path generation
    const { posts } = await getAllPosts({ perPage: 100 });
    return posts.map(post => ({
      params: { slug: post.slug },
      props: { post },
    }));
  } catch {
    // Return empty if WP not connected — pages will 404 gracefully
    return [];
  }
}

interface Props {
  post: WPPost;
}

const { post } = Astro.props;
const { slug } = Astro.params;

// If post not in props (e.g. dev mode), fetch it
let displayPost: WPPost | null = post || null;
if (!displayPost) {
  try {
    displayPost = await getPostBySlug(slug);
  } catch {
    return Astro.redirect('/blog');
  }
}

if (!displayPost) {
  return Astro.redirect('/blog');
}

const imageUrl = getImageUrl(displayPost);
const mins = readingTime(displayPost.content.rendered);
const authorName = displayPost.acf?.author_name as string || 'PatrolPilot Team';
const authorRole = displayPost.acf?.author_role as string || 'Security Industry Expert';
---

<Layout
  title={stripHtml(displayPost.title.rendered)}
  type="article"
  publishDate={displayPost.date}
  modifiedDate={displayPost.modified}
  author={authorName}
  image={imageUrl || undefined}
  seo={displayPost.yoast_head_json}
>

  <!-- Article Hero -->
  <section class="bg-[#0d2137] pt-[130px] pb-16 relative overflow-hidden">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 60% 60% at 60% 50%,rgba(31,168,75,.08) 0%,transparent 60%)"></div>
    <div class="container relative z-10 max-w-[800px]">
      <a href="/blog" class="inline-flex items-center gap-2 font-display text-[.82rem] font-semibold text-white/50 hover:text-white mb-6 transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Blog
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono text-[.6rem] tracking-[.25em] uppercase text-[#1fa84b]">Security Insights</span>
        <span class="w-[3px] h-[3px] rounded-full bg-white/20"></span>
        <span class="font-mono text-[.6rem] tracking-[.14em] uppercase text-white/40">{formatDate(displayPost.date)}</span>
        <span class="w-[3px] h-[3px] rounded-full bg-white/20"></span>
        <span class="font-mono text-[.6rem] tracking-[.14em] uppercase text-white/40">{mins} min read</span>
      </div>
      <h1 class="font-display font-bold text-white tracking-[-0.045em] leading-[1.06] mb-5"
          style="font-size:clamp(2rem,4vw,3.2rem)"
          set:html={displayPost.title.rendered} />
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full flex items-center justify-center font-display text-[.7rem] font-bold text-white"
             style="background:linear-gradient(135deg,#142d4c,#178a3c)">
          {authorName.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
        </div>
        <div>
          <div class="font-display text-[.875rem] font-semibold text-white">{authorName}</div>
          <div class="font-mono text-[.57rem] tracking-[.1em] uppercase text-white/40">{authorRole}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured image -->
  {imageUrl && (
    <div class="w-full max-w-[900px] mx-auto -mt-8 px-6 relative z-10">
      <img src={imageUrl} alt={stripHtml(displayPost.title.rendered)} class="w-full h-[400px] object-cover rounded-[16px] shadow-[0_24px_64px_rgba(13,33,55,.18)]" loading="eager" />
    </div>
  )}

  <!-- Article content -->
  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-16 max-w-[1080px] mx-auto">

        <!-- Main content from WordPress -->
        <article>
          <div class="prose" set:html={displayPost.content.rendered} />

          <!-- Tags -->
          {displayPost._embedded?.['wp:term']?.[1]?.length > 0 && (
            <div class="mt-10 pt-8 border-t border-[#d8e2ef]">
              <div class="font-mono text-[.57rem] tracking-[.22em] uppercase text-[#8599b0] mb-3">Tags</div>
              <div class="flex flex-wrap gap-2">
                {displayPost._embedded['wp:term'][1].map((tag) => (
                  <a href={`/blog/tag/${tag.slug}`}
                     class="px-3 py-1 text-[.8rem] font-semibold text-[#4e647d] border border-[#d8e2ef] rounded-[6px] hover:border-[#0d2137] hover:text-[#0d2137] hover:bg-[#f3f6fb] transition-colors">
                    #{tag.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Author card -->
          <div class="mt-10 p-6 bg-[#f3f6fb] rounded-[16px] border border-[#d8e2ef] flex items-start gap-4">
            <div class="w-14 h-14 rounded-full flex-shrink-0 flex items-center justify-center font-display font-bold text-white text-lg"
                 style="background:linear-gradient(135deg,#142d4c,#1fa84b)">
              {authorName.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
            </div>
            <div>
              <div class="font-display font-semibold text-[#0d2137] mb-1">{authorName}</div>
              <div class="font-mono text-[.58rem] tracking-[.15em] uppercase text-[#1fa84b] mb-2">{authorRole}</div>
              <p class="text-[.875rem] text-[#4e647d] leading-[1.65]">Expert contributor to the PatrolPilot blog, sharing insights on security workforce management, compliance, and technology for global security operations.</p>
            </div>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-[100px] space-y-6">

            <!-- CTA card -->
            <div class="bg-[#0d2137] rounded-[16px] p-6 text-white">
              <div class="font-display text-[1rem] font-bold mb-2">Ready to modernise your operation?</div>
              <p class="text-[.84rem] text-white/50 mb-4 leading-[1.6]">Join 500+ security companies on PatrolPilot.</p>
              <a href="/request-demo"
                 class="block text-center py-2.5 px-4 font-display text-[.875rem] font-semibold text-white rounded-[8px]
                        bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c]
                        hover:brightness-110 transition-all">
                Book a Free Demo
              </a>
            </div>

            <!-- Compliance badges -->
            <div class="p-5 bg-[#f3f6fb] rounded-[16px] border border-[#d8e2ef]">
              <div class="font-mono text-[.57rem] tracking-[.22em] uppercase text-[#8599b0] mb-3">Compliance</div>
              <div class="flex flex-wrap gap-1.5">
                {['ISO 27001','SOC 2','GDPR','CCPA','PDPA'].map(b => (
                  <span class="sec-badge sec-badge--dark text-[.5rem]">{b}</span>
                ))}
              </div>
            </div>

            <!-- Regions -->
            <div class="p-5 bg-[#f3f6fb] rounded-[16px] border border-[#d8e2ef]">
              <div class="font-mono text-[.57rem] tracking-[.22em] uppercase text-[#8599b0] mb-3">Available In</div>
              <div class="space-y-2">
                {['🇺🇸 USA','🇨🇦 Canada','🇬🇧 United Kingdom','🇦🇪 UAE','🇸🇬 Singapore'].map(r => (
                  <div class="text-[.84rem] text-[#4e647d]">{r}</div>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>
