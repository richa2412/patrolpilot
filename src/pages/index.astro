            <div class="flex items-center gap-2.5">
              <div class="w-[38px] h-[38px] rounded-full flex items-center justify-center font-display text-[.72rem] font-bold text-white flex-shrink-0"
                   style="background:linear-gradient(135deg,#142d4c,#178a3c)">
                {t.initials}
              </div>
              <div>
                <div class="font-display text-[.875rem] font-semibold text-[#0d2137]">{t.name}</div>
                <div class="font-mono text-[.56rem] text-[#8599b0] tracking-[.1em] mt-0.5">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden py-[110px] text-center" style="background:linear-gradient(135deg,#07111f,#0d2137,#0f2948)">
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 70% 80% at 50% 50%,rgba(31,168,75,.1) 0%,transparent 65%)"></div>
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:56px 56px"></div>
    <div class="container relative z-10">
      <div class="eyebrow-center reveal">Get Started Today</div>
      <h2 class="font-display font-bold text-white tracking-[-0.05em] leading-[.96] mx-auto mt-4 mb-5 reveal"
          style="font-size:clamp(2.2rem,4vw,3.6rem);max-width:620px" data-delay="1">
        Ready to modernise your security operations?
      </h2>
      <p class="text-[1rem] text-white/40 max-w-[520px] mx-auto mb-9 leading-[1.74] font-light reveal" data-delay="2">
