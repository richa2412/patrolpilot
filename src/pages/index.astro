---
/**
 * index.astro — Homepage
 * Hero, Security Ticker, Stats, Features, How It Works,
 * Security Identity section, Testimonials, CTA
 *
 * WordPress integration:
 *   - Homepage content blocks via ACF Flexible Content
 *   - Testimonials via custom post type 'testimonial'
 *   - Stats via ACF Options page
 */
import Layout from '@/layouts/Layout.astro';
import { STATS, FEATURES, SECURITY_TICKER_ITEMS, SITE } from '@/lib/config';

// Fetch dynamic content from WordPress at build time
// import { getACFOptions, getLatestPosts } from '@/lib/wordpress';
// const wpOptions = await getACFOptions();
// const latestPosts = await getLatestPosts(3);
---

<Layout
  title="Security Guard Management Software"
  description="Purpose-built security guard management software for the USA, Canada, UK, UAE and Singapore. GPS tracking, NFC checkpoints, scheduling and compliance."
>

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden min-h-screen flex items-center bg-[#0d2137] pt-[120px] pb-20">

    <!-- Background layers -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <!-- Radial gradients -->
      <div class="absolute inset-0"
           style="background: radial-gradient(ellipse 80% 70% at 105% 30%, rgba(31,168,75,.1) 0%, transparent 55%), radial-gradient(ellipse 60% 80% at -10% 80%, rgba(26,58,96,.65) 0%, transparent 55%), linear-gradient(185deg,#0d2137 0%,#091829 100%)">
      </div>
      <!-- Grid -->
      <div class="absolute inset-0"
           style="background-image:linear-gradient(rgba(255,255,255,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.026) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 100% 100% at 50% 0%,#000 15%,transparent 85%)">
      </div>
      <!-- Radar rings -->
      <div class="absolute" style="right:5%;top:50%;width:520px;height:520px;transform:translate(40%,-50%)">
        {[120,240,360,480].map((size,i) => (
          <div class="absolute rounded-full border border-[rgba(31,168,75,.1)]"
               style={`width:${size}px;height:${size}px;top:50%;left:50%;transform:translate(-50%,-50%);${i===0?'border-color:rgba(31,168,75,.25)':''}${i===2?'border-style:dashed':''}`}>
          </div>
        ))}
        <div class="absolute rounded-full border border-[rgba(31,168,75,.3)]"
             style="width:100px;height:100px;top:50%;left:50%;transform:translate(-50%,-50%);animation:ringExpand 3.5s ease-out infinite">
        </div>
        <div class="absolute rounded-full border border-[rgba(31,168,75,.3)]"
             style="width:100px;height:100px;top:50%;left:50%;transform:translate(-50%,-50%);animation:ringExpand 3.5s ease-out infinite 1.75s">
        </div>
      </div>
      <!-- Sweep -->
      <div class="absolute rounded-full overflow-hidden"
           style="right:5%;top:50%;width:260px;height:260px;transform:translate(40%,-50%)">
        <div class="absolute"
             style="top:50%;left:50%;width:50%;height:1.5px;background:linear-gradient(90deg,rgba(31,168,75,.9),rgba(31,168,75,.1),transparent);transform-origin:left center;animation:sweep 4s linear infinite">
        </div>
      </div>
      <!-- Scan lines -->
      <div class="absolute inset-0"
           style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.011) 3px,rgba(255,255,255,.011) 4px);animation:scanMove 14s linear infinite">
      </div>
    </div>

    <div class="container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_.95fr] gap-16 lg:gap-[72px] items-center">

        <!-- Left: Text -->
        <div>
          <div class="sec-badge sec-badge--navy mb-4 animate-fade-up inline-flex">
            <span class="badge-dot" style="background:#ef4444;animation:dotPulse 1.4s ease infinite"></span>
            Live — USA · Canada · UK · UAE · Singapore
          </div>

          <h1 class="font-display font-bold text-white leading-[.93] tracking-[-0.055em] mb-6 animate-fade-up [--delay:.1s]"
              style="font-size:clamp(3.2rem,5.2vw,5.2rem);animation-delay:.1s">
            Security Guard Management
            <span class="block"
                  style="background:linear-gradient(135deg,#2dd65a 0%,#1fa84b 50%,#148036 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
              Built for Global Teams.
            </span>
          </h1>

          <p class="text-[1.05rem] text-white/40 max-w-[480px] mb-9 leading-[1.76] font-light animate-fade-up" style="animation-delay:.2s">
            PatrolPilot gives security managers in the USA, Canada, UK, UAE and Singapore real-time visibility
            over every guard, checkpoint and incident. GPS tracking, NFC tours, scheduling and compliance —
            in one purpose-built platform.
          </p>

          <div class="flex items-center gap-3 flex-wrap animate-fade-up" style="animation-delay:.3s">
            <a href="/request-demo"
               class="inline-flex items-center gap-2 px-8 py-4 font-display text-[.95rem] font-semibold text-white rounded-[12px]
                      bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c]
                      shadow-[0_6px_20px_rgba(31,168,75,.3)]
                      hover:brightness-110 hover:-translate-y-0.5 transition-all duration-200">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 3l14 9-14 9V3z"/></svg>
              Book a Free Demo
            </a>
            <a href="/how-it-works"
               class="inline-flex items-center gap-2 px-8 py-4 font-display text-[.95rem] font-semibold text-white/85 rounded-[12px]
                      bg-white/[0.08] border border-white/[0.18] backdrop-blur-lg
                      hover:bg-white/16 hover:border-white/38 hover:text-white transition-all duration-200">
              See How It Works
            </a>
          </div>

          <!-- Trust badges -->
          <div class="trust-row animate-fade-up" style="animation-delay:.4s">
            <span class="trust-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
              USA · Canada · UK
            </span>
            <span class="trust-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14"/></svg>
              UAE · Singapore
            </span>
            <span class="trust-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              ISO 27001
            </span>
            <span class="trust-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 3l14 9-14 9V3z"/></svg>
              14-Day Free Trial
            </span>
          </div>

          <!-- Hero stats strip -->
          <div class="flex border border-white/[0.08] rounded-[10px] overflow-hidden bg-white/[0.03] backdrop-blur-[8px] w-fit mt-9 animate-fade-up" style="animation-delay:.5s">
            {STATS.map((s, i) => (
              <div class:list={['px-[22px] py-[14px] text-center', i < STATS.length - 1 && 'border-r border-white/[0.08]']}>
                <div class="font-display text-[1.8rem] font-bold text-white tracking-[-0.05em] leading-none">
                  {s.value}<span class="text-[#1fa84b]">{s.suffix}</span>
                </div>
                <div class="font-mono text-[.5rem] tracking-[.18em] uppercase text-white/30 mt-1">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Dashboard mockup -->
        <div class="relative hidden lg:block animate-fade-up" style="animation-delay:.2s">
          <div class="rounded-[16px] overflow-hidden border border-white/10"
               style="background:#0a1928;box-shadow:0 0 0 1px rgba(255,255,255,.05),0 40px 100px rgba(0,0,0,.55),0 0 80px rgba(31,168,75,.05)">
            <!-- Browser bar -->
            <div class="flex items-center gap-[7px] px-4 py-2.5 border-b border-white/[0.06]" style="background:#060f1c">
              <div class="w-[9px] h-[9px] rounded-full bg-[#ef4444]"></div>
              <div class="w-[9px] h-[9px] rounded-full bg-[#f59e0b]"></div>
              <div class="w-[9px] h-[9px] rounded-full bg-[#1fa84b]"></div>
              <span class="font-mono text-[.55rem] text-white/22 ml-1">app.patrolpilot.com/dashboard</span>
            </div>
            <!-- Dashboard body -->
            <div class="p-3.5">
              <!-- Live indicator -->
              <div class="flex items-center gap-[7px] mb-2.5 font-mono text-[.58rem] tracking-[.16em] uppercase">
                <div class="w-[7px] h-[7px] rounded-full bg-[#ef4444]" style="box-shadow:0 0 8px rgba(239,68,68,.7);animation:dotPulse 1.4s ease infinite"></div>
                <span class="text-white/30">LIVE OPERATIONS — </span>
                <strong class="text-[#ef4444]">ACTIVE</strong>
              </div>
              <!-- Map -->
              <div class="h-[155px] rounded-[10px] overflow-hidden relative mb-2.5 border border-white/[0.06]"
                   style="background:linear-gradient(135deg,#0f2440,#162e4d,#1a3a5c)">
                <div class="absolute inset-0"
                     style="background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:22px 22px">
                </div>
                {/* Guard pins */}
                {[{top:'30%',left:'25%'},{top:'52%',left:'60%'},{top:'18%',left:'72%',amber:true}].map((p, i) => (
                  <div class="absolute" style={`top:${p.top};left:${p.left}`}>
                    <div class="w-[9px] h-[9px] rounded-full relative z-10"
                         style={`background:${p.amber?'#f59e0b':'#1fa84b'};box-shadow:0 0 10px ${p.amber?'rgba(245,158,11,.8)':'rgba(31,168,75,.8)'}`}>
                    </div>
                    <div class="absolute -top-[5px] -left-[5px] w-[19px] h-[19px] rounded-full border-2"
                         style={`border-color:${p.amber?'rgba(245,158,11,.5)':'rgba(31,168,75,.5)'};animation:pinPing 2.2s ease-out infinite ${i*0.8}s`}>
                    </div>
                  </div>
                ))}
                <div class="absolute bottom-[7px] left-[9px] font-mono text-[.52rem] tracking-[.1em] px-2 py-0.5 rounded border border-white/[0.08]"
                     style="background:rgba(10,25,45,.92);color:rgba(255,255,255,.65)">
                  Operations Overview — 24 Active Sites
                </div>
              </div>
              <!-- Stats row -->
              <div class="grid grid-cols-3 gap-[7px]">
                {[{n:'18',l:'On Duty',c:'#1fa84b'},{n:'3',l:'En Route',c:'#f59e0b'},{n:'24',l:'Sites',c:'#fff'}].map(s => (
                  <div class="rounded-[7px] p-2 text-center border border-white/[0.07]" style="background:rgba(255,255,255,.04)">
                    <div class="font-display text-[1.15rem] font-bold leading-none tracking-[-0.04em]" style={`color:${s.c}`}>{s.n}</div>
                    <div class="font-mono text-[.48rem] text-white/28 mt-0.5 uppercase tracking-[.1em]">{s.l}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Floating chips -->
          <div class="absolute -bottom-4 -left-5 flex items-center gap-2 px-3.5 py-2.5 rounded-[10px] border border-white/10 backdrop-blur-xl"
               style="background:rgba(8,18,34,.96);box-shadow:0 8px 28px rgba(0,0,0,.45);animation:chipFloat 5s ease-in-out infinite">
            <div class="w-[26px] h-[26px] rounded-[6px] flex items-center justify-center flex-shrink-0"
                 style="background:rgba(31,168,75,.14);color:#1fa84b">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div class="font-display text-[.72rem] font-semibold text-white leading-none">Checkpoint Scanned</div>
              <div class="font-mono text-[.52rem] text-white/32 mt-0.5 uppercase tracking-[.1em]">Gate B — City Tower · 2 min ago</div>
            </div>
          </div>

          <div class="absolute -top-4 -right-4 flex items-center gap-2 px-3.5 py-2.5 rounded-[10px] border border-white/10 backdrop-blur-xl"
               style="background:rgba(8,18,34,.96);box-shadow:0 8px 28px rgba(0,0,0,.45);animation:chipFloat 7s ease-in-out infinite .8s">
            <div class="w-[26px] h-[26px] rounded-[6px] flex items-center justify-center flex-shrink-0"
                 style="background:rgba(239,68,68,.14);color:#ef4444">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07"/></svg>
            </div>
            <div>
              <div class="font-display text-[.72rem] font-semibold text-white leading-none">SOS Alert Resolved</div>
              <div class="font-mono text-[.52rem] text-white/32 mt-0.5 uppercase tracking-[.1em]">Westfield Site · 14 min ago</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECURITY TICKER ──────────────────────────────────────────────────── -->
  <div class="overflow-hidden py-4 border-t border-white/5 border-b border-white/5" style="background:#060f1c" aria-hidden="true">
    <div class="flex items-center gap-9 whitespace-nowrap" style="animation:tickerMove 30s linear infinite">
      {[...SECURITY_TICKER_ITEMS, ...SECURITY_TICKER_ITEMS].map(item => (
        <span class="flex items-center gap-2.5 flex-shrink-0 font-mono text-[.6rem] tracking-[.18em] uppercase text-white/30">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {item.label}
        </span>
        <span class="w-[3px] h-[3px] rounded-full bg-white/15 flex-shrink-0"></span>
      ))}
    </div>
  </div>

  <!-- ── COUNTRIES STRIP ──────────────────────────────────────────────────── -->
  <div class="py-12 border-b border-[#d8e2ef]">
    <div class="container">
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <span class="font-mono text-[.58rem] tracking-[.22em] uppercase text-[#8599b0] mr-2">
          Serving Security Companies In
        </span>
        {[{flag:'🇺🇸',label:'United States'},{flag:'🇨🇦',label:'Canada'},{flag:'🇬🇧',label:'United Kingdom'},{flag:'🇦🇪',label:'UAE'},{flag:'🇸🇬',label:'Singapore'}].map(c => (
          <span class="flex items-center gap-1.5 px-4 py-2 border-[1.5px] border-[#d8e2ef] rounded-[8px]
                        font-display text-[.85rem] font-semibold text-[#0d2137] bg-[#f3f6fb]
                        hover:border-[#1fa84b] hover:shadow-[0_2px_12px_rgba(31,168,75,.12)] transition-all cursor-default">
            {c.flag} {c.label}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ── STATS STRIP ──────────────────────────────────────────────────────── -->
  <div class="bg-[#0d2137] border-t border-white/[0.06] border-b border-white/[0.06]">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {STATS.map((s, i) => (
          <div class:list={[
            'px-7 py-[34px] relative overflow-hidden group',
            'transition-colors duration-300 hover:bg-white/[.03]',
            i < STATS.length - 1 && 'border-r border-white/[0.06]',
          ]}>
            <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-[#1fa84b] to-transparent scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-500"></div>
            <div class="font-display text-[2.6rem] font-bold text-white tracking-[-0.06em] leading-none mb-1.5">
              {s.value}<span class="text-[#1fa84b]">{s.suffix}</span>
            </div>
            <div class="font-mono text-[.57rem] tracking-[.2em] uppercase text-white/28">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── FEATURES ─────────────────────────────────────────────────────────── -->
  <section class="section bg-[#f3f6fb]">
    <div class="container">
      <div class="text-center mb-16">
        <div class="eyebrow-center reveal">Platform Capabilities</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.045em] leading-[1.02] mt-3.5 reveal"
            style="font-size:clamp(2rem,3.5vw,3rem)" data-delay="1">
          Everything your security operation needs
        </h2>
        <p class="text-[1.02rem] text-[#4e647d] max-w-[560px] mx-auto mt-3.5 font-light leading-[1.72] reveal" data-delay="2">
          GPS tracking, NFC checkpoints, scheduling, compliance — PatrolPilot replaces disconnected tools with one unified platform.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[18px]">
        {FEATURES.map((f, i) => (
          <div class="bg-white rounded-[16px] border border-[#d8e2ef] p-7 relative overflow-hidden group
                       hover:border-[rgba(31,168,75,.2)] hover:shadow-[0_8px_32px_rgba(13,33,55,.1)] hover:-translate-y-1
                       transition-all duration-[.24s] reveal" data-delay={String((i % 3) + 1)}>
            <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-[#1fa84b] to-[#178a3c] scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-[.35s] ease-[cubic-bezier(.16,1,.3,1)]"></div>
            <div class="font-mono text-[.54rem] tracking-[.22em] uppercase text-[#8599b0] mb-3.5">
              {String(i + 1).padStart(2, '0')} / {f.id.toUpperCase()}
            </div>
            <div class="w-[46px] h-[46px] rounded-[12px] bg-[#e8f8ee] flex items-center justify-center mb-4
                         group-hover:bg-[#1fa84b] transition-colors duration-[.24s]">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2"
                   class="group-hover:stroke-white transition-colors duration-[.24s]">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="font-display text-[1.02rem] font-semibold text-[#0d2137] tracking-[-0.022em] mb-2.5">{f.title}</h3>
            <p class="text-[.875rem] text-[#4e647d] leading-[1.7]">{f.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-11 reveal">
        <a href="/features"
           class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.88rem] font-semibold text-white
                  bg-[#0d2137] rounded-[10px] shadow-[0_6px_20px_rgba(13,33,55,.28)]
                  hover:-translate-y-0.5 hover:bg-[#142d4c] hover:shadow-[0_14px_36px_rgba(13,33,55,.38)] transition-all">
          View All Features
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── SECURITY IDENTITY ─────────────────────────────────────────────────── -->
  <section class="section relative overflow-hidden" style="background:var(--navy)">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 60% 70% at 85% 50%,rgba(31,168,75,.1) 0%,transparent 60%)"></div>
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:56px 56px"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-[72px] items-center">
        <div>
          <div class="eyebrow eyebrow--light reveal">Enterprise-Grade Security</div>
          <h2 class="font-display font-bold text-white tracking-[-0.045em] leading-[1.02] mt-4 mb-5 reveal"
              style="font-size:clamp(2rem,3.5vw,3rem)" data-delay="1">
            Enterprise-grade security. Every region.
          </h2>
          <p class="text-[1rem] text-white/40 leading-[1.74] font-light mb-8 reveal" data-delay="2">
            Every data point in PatrolPilot is protected with AES-256 encryption, hosted on regional cloud infrastructure
            in your country, and audited to ISO 27001 — meeting GDPR, CCPA, PDPA and UAE PDPL requirements.
          </p>
          <div class="space-y-5 reveal" data-delay="3">
            {[
              {title:'AES-256 Encryption',desc:'All guard data, locations and reports encrypted at rest and in transit.'},
              {title:'Regional Data Sovereignty',desc:'Data hosted in-country: US-East, EU-West, ME-Central, AP-Southeast.'},
              {title:'99.9% Uptime SLA',desc:'Multi-region redundancy ensures patrol operations are never interrupted.'},
              {title:'Real-time Audit Logs',desc:'Every action logged with timestamps for compliance and investigations.'},
            ].map(item => (
              <div class="flex items-start gap-3">
                <div class="w-[40px] h-[40px] rounded-[10px] flex-shrink-0 flex items-center justify-center"
                     style="background:rgba(31,168,75,.1);border:1px solid rgba(31,168,75,.2);color:#1fa84b">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                </div>
                <div>
                  <div class="font-display text-[.9rem] font-semibold text-white mb-0.5">{item.title}</div>
                  <div class="text-[.82rem] text-white/40 leading-[1.55]">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="reveal reveal-r" data-delay="2">
          <div class="grid grid-cols-2 gap-3">
            {[
              {v:'256-bit',l:'Encryption',c:'#fff',g:''},
              {v:'99%',l:'Uptime SLA',c:'#1fa84b',g:''},
              {v:'GLOBAL',l:'5 Countries',c:'#1fa84b',g:''},
              {v:'ISO\n27001',l:'Certified',c:'#fff',g:''},
            ].map(card => (
              <div class="rounded-[14px] p-6 text-center border border-white/10 bg-white/5">
                <div class="font-display text-[2.2rem] font-bold leading-none tracking-[-0.05em] whitespace-pre-line" style={`color:${card.c}`}>{card.v}</div>
                <div class="font-mono text-[.56rem] tracking-[.18em] uppercase text-white/30 mt-1.5">{card.l}</div>
              </div>
            ))}
          </div>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="sec-badge sec-badge--navy"><span class="badge-dot"></span>SOC 2 Type II</span>
            <span class="sec-badge sec-badge--navy">GDPR &amp; CCPA</span>
            <span class="sec-badge sec-badge--navy">PDPA &amp; UAE PDPL</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ─────────────────────────────────────────────────────── -->
  <section class="section bg-[#f3f6fb]">
    <div class="container">
      <div class="text-center mb-14">
        <div class="eyebrow-center reveal">Customer Stories</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.045em] leading-[1.02] mt-3.5 reveal"
            style="font-size:clamp(2rem,3.5vw,3rem)" data-delay="1">
          Trusted by security leaders worldwide
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[18px]">
        {[
          {initials:'MK',name:'Marcus Kelly',role:'Operations Director · USA Security Group',quote:'PatrolPilot completely replaced our paper-based system. We can now see every guard in real time and generate client reports in seconds.'},
          {initials:'SR',name:'Sarah Roberts',role:'General Manager · UK Metro Guard Services',quote:'The NFC checkpoint tours are a game-changer. Our clients love the automated patrol reports and we\'ve reduced no-show incidents by over 90%.'},
          {initials:'JT',name:'James Thompson',role:'CEO · Protect360 Security — Dubai',quote:'Licence compliance alone has saved us thousands in potential fines. PatrolPilot alerts us before a licence expires.'},
        ].map((t, i) => (
          <div class="bg-white rounded-[16px] border border-[#d8e2ef] p-7 hover:shadow-[0_8px_32px_rgba(13,33,55,.13)] hover:-translate-y-[3px] transition-all reveal" data-delay={String(i+1)}>
            <div class="text-[#f59e0b] text-[.9rem] mb-3.5 tracking-[2px]">★★★★★</div>
