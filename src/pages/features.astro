---
/**
 * features.astro
 * Full platform features — 9 modules with detail
 * WP: content from page slug 'features' via ACF flexible content
 */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { FEATURES } from '@/lib/config';
const SECURITY_TICKER_ICON_PATHS: Record<string, string> = {
  shield: 'M12 2l7 4v6c0 5-3.5 8.7-7 10-3.5-1.3-7-5-7-10V6l7-4z',
  'shield-check': 'M12 2l7 4v6c0 5-3.5 8.7-7 10-3.5-1.3-7-5-7-10V6l7-4zM9 12l2 2 4-4',
  clock: 'M12 6v6l4 2M12 2a10 10 0 100 20 10 10 0 000-20z',
  'map-pin': 'M12 21s6-4.5 6-11a6 6 0 10-12 0c0 6.5 6 11 6 11zM12 10a2 2 0 100-4 2 2 0 000 4z',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z',
  'phone-call': 'M22 16.9v3a2 2 0 01-2.2 2A20 20 0 019.2 18a20 20 0 01-6.3-6.3A20 20 0 011 5.1 2 2 0 013 3h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L7 10.4a16 16 0 006.6 6.6l1.1-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0122 16.9z',
  'file-text': 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8zM14 2v6h6M8 13h8M8 17h8M8 9h4',
  smartphone: 'M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zM12 18h.01',
  'check-circle': 'M22 11.1V12a10 10 0 11-5.9-9.1M22 4L12 14l-3-3',
  'bar-chart': 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  'bar-chart-2': 'M6 20v-6M12 20V4M18 20v-10',
  navigation: 'M3 11l18-8-8 18-2-8-8-2z',
  'dollar-sign': 'M12 2v20M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6',
};

---

<Layout
  title="Security Guard Management Features"
  description="Full feature set — GPS tracking, NFC checkpoints, scheduling, compliance, incident reports, SOS alerts and the guard mobile app. Every plan includes everything."
>
  <PageHero
    eyebrow="Full Feature Set"
    title="Everything you need to run a"
    titleEm="modern security operation."
    sub="From real-time guard tracking to automated compliance — PatrolPilot gives you complete visibility and control over every aspect of your security workforce."
  >
    <div class="flex gap-3 flex-wrap mt-6">
      <a href="/request-demo" class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white rounded-[10px] bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c] shadow-[0_6px_20px_rgba(31,168,75,.3)] hover:brightness-110 hover:-translate-y-px transition-all">Book Demo</a>
      <a href="/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white/85 rounded-[10px] bg-white/[0.08] border border-white/[0.18] hover:bg-white/[0.16] hover:text-white transition-all">View Pricing</a>
    </div>
  </PageHero>
 <!-- ── FEATURES ─────────────────────────────────────────────────────────── -->
  <section class="section bg-[#f3f6fb]">
    <div class="container">
      <div class="text-center mb-16">
        <div class="eyebrow-center reveal">9 Core Modules</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.045em] leading-[1.02] mt-3.5 reveal"
            style="font-size:clamp(2rem,3.5vw,3rem)" data-delay="1">
          Built for every part of your operation
        </h2>
        <!-- <p class="text-[1.02rem] text-[#4e647d] max-w-[560px] mx-auto mt-3.5 font-light leading-[1.72] reveal" data-delay="2">
          From guard tracking to compliance reporting — PatrolPilot replaces spreadsheets, paper logs, and disconnected tools with one unified platform.
        </p> -->
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[18px]">
        {FEATURES.map((f, i) => (
          <div class="bg-white rounded-[16px] border border-[#d8e2ef] p-7 relative overflow-hidden group
                       hover:border-[rgba(31,168,75,.2)] hover:shadow-[0_8px_32px_rgba(13,33,55,.1)] hover:-translate-y-1
                       transition-all duration-[.24s] reveal" data-delay={String((i % 3) + 1)}>
            <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-[#1fa84b] to-[#178a3c] scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-[.35s] ease-[cubic-bezier(.16,1,.3,1)]"></div>
            <div class="font-mono text-[.54rem] tracking-[.22em] uppercase text-[#8599b0] mb-3.5">
              {String(i + 1).padStart(2, '0')} / {f.id.toUpperCase()}
            </div>
            <div class="w-[44px] h-[44px] rounded-[12px] bg-[#eef8ef] flex items-center justify-center mb-4
                         group-hover:bg-[#1fa84b] transition-colors duration-[.24s]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.15"
                   stroke-linecap="round" stroke-linejoin="round"
                   class="group-hover:stroke-white transition-colors duration-[.24s]">
                <path d={SECURITY_TICKER_ICON_PATHS[f.icon] ?? SECURITY_TICKER_ICON_PATHS.shield} />
              </svg>
            </div>
            <h3 class="font-display text-[1.02rem] font-semibold text-[#0d2137] tracking-[-0.022em] mb-2.5">{f.title}</h3>
            <p class="text-[.875rem] text-[#4e647d] leading-[1.7]">{f.desc}</p>
          </div>
        ))}
      </div>
      
    </div>
  </section>

  <CTASection />
</Layout>
