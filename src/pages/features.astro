---
/**
 * features.astro
 * Full platform features — 9 modules with detail
 * WP: content from page slug 'features' via ACF flexible content
 */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';

const features = [
  {
    num: '01', cat: 'TRACKING',
    title: 'Live GPS Guard Tracking',
    desc: 'Real-time location of every guard on an interactive map. Instant alerts for missed check-ins, SOS events and geofence breaches. Full shift history and route replay.',
    details: ['30-second GPS update intervals', 'Geofence entry/exit alerts', 'Historical route replay', 'Multi-site map overview', 'Battery-efficient background tracking'],
    icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 7a3 3 0 100 6 3 3 0 000-6z',
  },
  {
    num: '02', cat: 'CHECKPOINTS',
    title: 'NFC Checkpoint Tours',
    desc: 'Guards tap NFC tags at checkpoints to verify presence. Generates timestamped patrol reports automatically. Tamper-proof proof-of-attendance for clients.',
    details: ['One-tap NFC scanning', 'Auto-generated patrol reports', 'Missed checkpoint alerts', 'Custom patrol routes', 'Offline mode — syncs when online'],
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  },
  {
    num: '03', cat: 'SCHEDULING',
    title: 'Smart Guard Scheduling',
    desc: 'Drag-and-drop roster builder with intelligent conflict detection. Automatic licence compliance checks — never schedule a guard with expired credentials.',
    details: ['Drag-and-drop roster builder', 'Licence expiry auto-check', 'Overtime & availability rules', 'Shift swap management', 'Copy weekly rosters'],
    icon: 'M3 4h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V6a2 2 0 012-2zM16 2v4M8 2v4M2 10h20',
  },
  {
    num: '04', cat: 'INCIDENTS',
    title: 'Digital Incident Reports',
    desc: 'Structured, photo-enabled incident reports submitted from guards\' phones. Automatic client notifications and escalation workflows.',
    details: ['Structured report templates', 'Photo and signature capture', 'GPS-tagged automatically', 'Instant supervisor alerts', 'Client email notifications'],
    icon: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8zM14 2v6h6',
  },
  {
    num: '05', cat: 'SOS',
    title: 'SOS & Lone Worker Alerts',
    desc: 'One-tap SOS button alerts supervisors instantly with the guard\'s exact location. Periodic welfare checks for lone workers in high-risk environments.',
    details: ['One-tap SOS panic button', 'Instant GPS location share', 'Lone worker check-in timer', 'Escalation to supervisor chain', 'Full alert history & audit log'],
    icon: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.21 2 2 0 012 0h3a2 2 0 012 1.72',
  },
  {
    num: '06', cat: 'COMPLIANCE',
    title: 'Licence & Cert Tracking',
    desc: 'Track security licence expiry, first aid certificates and working rights. Automatic reminders before expiry. Non-compliant guards blocked from scheduling.',
    details: ['Multi-licence type support', 'Expiry reminder emails', 'Scheduling block for expired licences', 'Compliance audit reports', 'Document upload & storage'],
    icon: 'M22 11.08V12a10 10 0 11-5.93-9.14M22 4L12 14.01l-3-3',
  },
  {
    num: '07', cat: 'PAYROLL',
    title: 'Timesheet & Payroll Integration',
    desc: 'Automatic timesheets from clock-in/clock-out data. Exports to ADP, QuickBooks, Xero and Sage. Eliminates manual time entry and payroll errors.',
    details: ['GPS-verified clock in/out', 'Automatic timesheet generation', 'ADP, QuickBooks, Xero, Sage', 'Overtime calculation', 'Pay period summaries'],
    icon: 'M12 2v20M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6',
  },
  {
    num: '08', cat: 'REPORTING',
    title: 'Analytics & Reporting',
    desc: 'Real-time KPI dashboards, client patrol reports, guard performance metrics and compliance summaries. White-label client portal included.',
    details: ['Live operations dashboard', 'White-label client portal', 'Guard performance metrics', 'Compliance KPI reports', 'Scheduled report delivery'],
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
  },
  {
    num: '09', cat: 'MOBILE',
    title: 'Guard Mobile App',
    desc: 'iOS and Android app for guards. Shift notifications, clock-in, patrol routes, incident forms and SOS — all in one purpose-built guard app.',
    details: ['iOS & Android (free for guards)', 'Full offline mode', 'Push notifications', 'Shift schedule view', 'In-app messaging'],
    icon: 'M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zM12 18h.01',
  },
];
---

<Layout
  title="Security Guard Management Features"
  description="Full feature set — GPS tracking, NFC checkpoints, scheduling, compliance, incident reports, SOS alerts and the guard mobile app. Every plan includes everything."
>
  <PageHero
    eyebrow="Full Feature Set"
    title="Everything you need to run a"
    titleEm="modern security operation."
    sub="From real-time guard tracking to automated compliance — PatrolPilot gives you complete visibility and control over every aspect of your security workforce."
  >
    <div class="flex gap-3 flex-wrap mt-6">
      <a href="/request-demo" class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white rounded-[10px] bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c] shadow-[0_6px_20px_rgba(31,168,75,.3)] hover:brightness-110 hover:-translate-y-px transition-all">Book Demo</a>
      <a href="/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white/85 rounded-[10px] bg-white/[0.08] border border-white/[0.18] hover:bg-white/[0.16] hover:text-white transition-all">View Pricing</a>
    </div>
  </PageHero>

  <!-- Feature cards: detailed -->
  <section class="section bg-[#f3f6fb]">
    <div class="container">
      <div class="text-center mb-14">
        <div class="eyebrow-center reveal">9 Core Modules</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.045em] leading-[1.02] mt-3.5 reveal" style="font-size:clamp(2rem,3.5vw,3rem)" data-delay="1">
          Built for every part of your operation
        </h2>
      </div>

      <div class="space-y-5">
        {features.map((f, i) => (
          <div class:list={[
            "bg-white rounded-[16px] border border-[#d8e2ef] overflow-hidden",
            "hover:border-[rgba(31,168,75,.2)] hover:shadow-[0_8px_32px_rgba(13,33,55,.1)]",
            "transition-all duration-[.24s] reveal",
          ]} data-delay={String((i % 3) + 1)}>
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px]">
              <!-- Left: content -->
              <div class="p-8">
                <div class="flex items-start gap-4 mb-5">
                  <div class="w-[50px] h-[50px] rounded-[12px] bg-[#e8f8ee] flex items-center justify-center flex-shrink-0">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2">
                      <path d={f.icon} />
                    </svg>
                  </div>
                  <div>
                    <div class="font-mono text-[.54rem] tracking-[.22em] uppercase text-[#8599b0] mb-1">{f.num} / {f.cat}</div>
                    <h3 class="font-display text-[1.2rem] font-700 text-[#0d2137] tracking-[-0.025em]">{f.title}</h3>
                  </div>
                </div>
                <p class="text-[.9rem] text-[#4e647d] leading-[1.72] max-w-xl">{f.desc}</p>
              </div>
              <!-- Right: detail list -->
              <div class="bg-[#f3f6fb] border-l border-[#d8e2ef] p-7 lg:p-8 flex flex-col justify-center">
                <div class="font-mono text-[.55rem] tracking-[.22em] uppercase text-[#8599b0] mb-4">What's included</div>
                <ul class="space-y-2.5">
                  {f.details.map(d => (
                    <li class="flex items-start gap-2.5 text-[.84rem] text-[#4e647d]">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.5" class="flex-shrink-0 mt-0.5">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {d}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance row -->
  <section class="section-sm bg-[#0d2137]">
    <div class="container">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="font-mono text-[.58rem] tracking-[.22em] uppercase text-white/30 mb-2">Security & Compliance</div>
          <div class="font-display text-[1.1rem] font-bold text-white tracking-[-0.02em]">Enterprise-grade security built into every feature</div>
        </div>
        <div class="flex flex-wrap gap-2">
          {['AES-256 Encrypted','ISO 27001','SOC 2 Type II','GDPR','CCPA','PDPA','UAE PDPL'].map(b => (
            <span class="sec-badge sec-badge--navy">{b}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
