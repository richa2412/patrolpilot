---
/**
 * pricing.astro
 * Single price entry + contact sales form
 * Content can be overridden via WordPress ACF options page
 */
import Layout from "@/layouts/Layout.astro";
import { PRICING } from "@/lib/config";

const PRICING_CARD_META = [
  {
    note: "Up to 25 guards / mo",
    priceColor: "#10243d",
    noteColor: "#8b9bb2",
    monthlyColor: "#8b9bb2",
    featureColor: "#516a88",
    cardClass: "bg-white border-[#d7e1ee]",
    dividerClass: "bg-[#d7e1ee]",
    features: [
      "Full platform access",
      "GPS + NFC checkpoints",
      "Guard mobile app",
      "Scheduling & compliance",
      "Email & chat support",
    ],
  },
  {
    note: "Up to 75 guards / mo",
    priceColor: "#24a84c",
    noteColor: "#8b9bb2",
    monthlyColor: "#8b9bb2",
    featureColor: "#516a88",
    cardClass: "bg-white border-[#bfe7c8] shadow-[0_0_0_1px_rgba(36,168,76,.08)]",
    dividerClass: "bg-[#d7e1ee]",
    badge: "Popular",
    features: [
      "Everything in Starter",
      "Client patrol portal",
      "Payroll integration",
      "Advanced analytics",
      "Priority support",
    ],
  },
  {
    note: "Up to 200 guards / mo",
    priceColor: "#10243d",
    noteColor: "#8b9bb2",
    monthlyColor: "#8b9bb2",
    featureColor: "#516a88",
    cardClass: "bg-white border-[#d7e1ee]",
    dividerClass: "bg-[#d7e1ee]",
    features: [
      "Everything in Growth",
      "Dedicated account manager",
      "Custom integrations",
      "White-label reports",
      "4-hr support SLA",
    ],
  },
  {
    note: "200+ guards / mo",
    priceColor: "#ffffff",
    noteColor: "rgba(255,255,255,.28)",
    monthlyColor: "rgba(255,255,255,.28)",
    featureColor: "rgba(255,255,255,.72)",
    cardClass: "bg-[#10243d] border-[#10243d]",
    dividerClass: "bg-white/10",
    features: [
      "Unlimited guards & sites",
      "Custom workflows & API",
      "SLA + 24/7 phone support",
      "On-site training",
      "Dedicated infrastructure",
    ],
  },
] as const;

const INCLUDED_FEATURE_ICON_PATHS: Record<string, string> = {
  location: 'M12 21s6-4.5 6-11a6 6 0 10-12 0c0 6.5 6 11 6 11zM12 10a2 2 0 100-4 2 2 0 000 4z',
  shield: 'M12 2l7 4v6c0 5-3.5 8.7-7 10-3.5-1.3-7-5-7-10V6l7-4z',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z',
  smartphone: 'M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zM12 18h.01',
  check: 'M20 6 9 17l-5-5',
  file: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8zM14 2v6h6M8 13h8M8 17h8M8 9h4',
  sos: 'M22 16.9v3a2 2 0 01-2.2 2A20 20 0 019.2 18a20 20 0 01-6.3-6.3A20 20 0 011 5.1 2 2 0 013 3h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L7 10.4a16 16 0 006.6 6.6l1.1-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0122 16.9z',
  activity: 'M3 12h4l3-8 4 16 3-8h4',
  lock: 'M7 11V7a5 5 0 0110 0v4M6 11h12a2 2 0 012 2v7a2 2 0 01-2 2H6a2 2 0 01-2-2v-7a2 2 0 012-2z',
};

const INCLUDED_FEATURES = [
  {
    icon: 'location',
    title: 'Live GPS Guard Tracking',
    desc: 'Real-time location of every guard on every shift.',
  },
  {
    icon: 'shield',
    title: 'NFC Checkpoint Patrols',
    desc: 'Verified, timestamped proof-of-patrol at every checkpoint.',
  },
  {
    icon: 'calendar',
    title: 'Guard Scheduling',
    desc: 'Drag-and-drop roster builder with compliance checks.',
  },
  {
    icon: 'smartphone',
    title: 'Guard Mobile App',
    desc: 'iOS & Android app for clock-in, tours, incidents and SOS.',
  },
  {
    icon: 'check',
    title: 'Licence Compliance',
    desc: 'Automated licence expiry tracking and scheduling blocks.',
  },
  {
    icon: 'file',
    title: 'Digital Incident Reports',
    desc: 'Photo-enabled reports submitted instantly from the field.',
  },
  {
    icon: 'sos',
    title: 'SOS & Lone Worker',
    desc: 'One-tap SOS alerts supervisors instantly with GPS location.',
  },
  {
    icon: 'activity',
    title: 'Real-time Analytics',
    desc: 'KPI dashboards, guard performance and compliance reports.',
  },
  {
    icon: 'lock',
    title: 'AES-256 Encryption',
    desc: 'Bank-grade security on all data, at rest and in transit.',
  },
] as const;

const SALES_HIGHLIGHT_ICON_PATHS: Record<string, string> = {
  pricing: 'M20 6 9 17l-5-5',
  shield: 'M12 2l7 4v6c0 5-3.5 8.7-7 10-3.5-1.3-7-5-7-10V6l7-4z',
  support: 'M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20M12 2c3 3.5 3 12 0 20M12 2c-3 3.5-3 12 0 20',
  rocket: 'M5 3l14 9-14 9V3z',
};

const SALES_HIGHLIGHTS = [
  {
    icon: 'pricing',
    title: 'Transparent Pricing',
    desc: 'Starting from $3,500/yr - no hidden fees',
  },
  {
    icon: 'shield',
    title: 'Full Platform Included',
    desc: 'GPS, NFC, scheduling, compliance, mobile app',
  },
  {
    icon: 'support',
    title: 'Regional Support',
    desc: 'Local teams in USA, UK, UAE & Singapore',
  },
  {
    icon: 'rocket',
    title: 'Fast Onboarding',
    desc: 'Up and running within 48 hours',
  },
] as const;
---

<Layout
  title="Pricing"
  description="PatrolPilot pricing - licence tiers starting from $3,500 per annum based on guards scheduled. Contact our team to find the right deal."
>
  <!-- Hero -->
  <section class="bg-[#0d2137] pt-[140px] pb-24 relative overflow-hidden text-center">
    <div
      class="absolute inset-0"
      style="background:radial-gradient(ellipse 70% 80% at 50% 60%,rgba(31,168,75,.12) 0%,transparent 65%)"
    ></div>
    <div
      class="absolute inset-0"
      style="background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:60px 60px;mask-image:linear-gradient(0deg,transparent 0%,#000 30%,#000 70%,transparent 100%)"
    ></div>
    <div class="container relative z-10">
      <div class="eyebrow-center animate-fade-up">Simple Pricing</div>
      <h1
        class="font-display font-bold text-white tracking-[-0.055em] leading-[.94] mt-4 mb-5 animate-fade-up"
        style="font-size:clamp(2.8rem,5vw,4.4rem);animation-delay:.1s"
      >
        Let's find a deal that
        <span
          class="block"
          style="background:linear-gradient(135deg,#2dd65a,#1fa84b,#148036);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"
        >
          works for you.
        </span>
      </h1>
      <p
        class="text-[1.1rem] text-white/40 max-w-[560px] mx-auto mb-8 leading-[1.72] font-light animate-fade-up"
        style="animation-delay:.2s"
      >
        Licence tiers start at <strong class="text-white font-semibold">$3,500 per annum</strong>,
        and are based on the number of guards you schedule each month. No hidden fees. No lock-in.
      </p>
      <div
        class="inline-flex items-center gap-0 bg-white/[0.06] border border-white/10 rounded-[20px] p-1.5 backdrop-blur-lg mb-8 animate-fade-up"
        style="animation-delay:.3s"
      >
        <span class="font-mono text-[.6rem] tracking-[.2em] uppercase text-white/40 px-4 py-2">
          Starting from
        </span>
        <span
          class="bg-[#1fa84b] rounded-[14px] px-5 py-2.5 font-display text-[1rem] font-bold text-white tracking-[-0.02em]"
        >
          $3,500 / year
        </span>
      </div>
      <div
        class="flex items-center justify-center gap-3 flex-wrap animate-fade-up"
        style="animation-delay:.4s"
      >
        {["No setup fees", "14-day free trial", "Cancel anytime", "Region hosted"].map((t) => (
          <span class="trust-badge">
            <svg
              width="10"
              height="10"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#1fa84b"
              stroke-width="2.5"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Tier cards -->
  <section class="bg-[#eef2f7] py-20 md:py-24">
    <div class="container">
      <div class="max-w-[920px] mx-auto text-center mb-14 md:mb-16">
        <div class="eyebrow-center reveal">Guard-Based Tiers</div>
        <h2
          class="font-display font-bold text-[#10243d] tracking-[-0.055em] leading-[1.02] mt-4 reveal"
          style="font-size:clamp(1.8rem,3vw,2.8rem)"
          data-delay="1"
        >
          Pricing based on guards scheduled per month
        </h2>
        <p
          class="text-[1.04rem] text-[#516a88] max-w-[540px] mx-auto mt-4 leading-[1.72] reveal"
          data-delay="2"
        >
          Every tier includes the full platform - GPS tracking, NFC checkpoints,
          scheduling, compliance, incident reports and the guard mobile app. The
          only difference is scale.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 xl:gap-5">
        {PRICING.tiers.map((tier, i) => {
          const meta = PRICING_CARD_META[i];

          return (
            <div
              class:list={[
                "group relative overflow-hidden rounded-[18px] border p-6 xl:p-6 transition-all duration-200",
                "hover:shadow-[0_8px_32px_rgba(13,33,55,.1)]",
                meta.cardClass,
                tier.popular && "",
              ]}
              data-delay={String((i % 4) + 1)}
            >
              <div
                class:list={[
                  "pointer-events-none absolute top-0 left-0 right-0 h-[3px] origin-left scale-x-0 transition-transform duration-300",
                  i === 3
                    ? "bg-gradient-to-r from-[#2dd65a] via-[#24a84c] to-[#1b7d37] group-hover:scale-x-100"
                    : "bg-gradient-to-r from-[#24a84c] to-[#178a3c] group-hover:scale-x-100",
                ]}
              ></div>
              {meta.badge && (
                <div class="absolute top-5 right-5 z-10 rounded-[6px] bg-[#24a84c] px-3 py-1.5 font-mono text-[.53rem] tracking-[.18em] uppercase text-white">
                  {meta.badge}
                </div>
              )}

              <div class="relative z-10">
                <div
                  class="font-mono text-[.6rem] tracking-[.3em] uppercase mb-6"
                  style={`color:${meta.noteColor}`}
                >
                  {meta.note}
                </div>

                <div class="mb-6">
                  <div
                    class="font-display font-bold tracking-[-0.06em] leading-[.92]"
                    style={`font-size:clamp(2.6rem,2.4vw,3.3rem);color:${meta.priceColor}`}
                  >
                    {tier.price ? `$${tier.price.toLocaleString()}` : "Custom"}
                    {tier.price && (
                      <span class="text-[.9rem] font-medium tracking-[-0.02em] text-inherit align-baseline">
                        /yr
                      </span>
                    )}
                  </div>
                  <div
                    class="font-mono text-[.58rem] tracking-[.24em] uppercase mt-3"
                    style={`color:${meta.monthlyColor}`}
                  >
                    {tier.monthly ? `~ $${tier.monthly.toLocaleString()} per month` : "Enterprise pricing"}
                  </div>
                </div>

                <div class:list={["h-px mb-6", meta.dividerClass]}></div>

                <ul class="space-y-3">
                  {meta.features.map((feat) => (
                    <li class="flex items-start gap-3 text-[.95rem] leading-[1.5]">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#24a84c"
                        stroke-width="2.5"
                        class="flex-shrink-0 mt-0.5"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span style={`color:${meta.featureColor}`}>
                        {feat}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>

      <p class="text-center font-mono text-[.68rem] tracking-[.28em] uppercase text-[#92a3bb] mt-10">
        Not sure which tier fits? Fill in the form below - we'll work it out together.
      </p>
    </div>
  </section>

  <!-- Included Features -->
  <section class="bg-white py-20 md:py-24">
    <div class="container">
      <div class="max-w-[900px] mx-auto text-center mb-14 md:mb-16">
        <div class="eyebrow-center reveal">Every Plan Includes</div>
        <h2
          class="font-display font-bold text-[#10243d] tracking-[-0.055em] leading-[1.02] mt-4 reveal"
           style="font-size:clamp(1.8rem,3vw,2.8rem)"
          data-delay="1"
        >
          The full platform, every tier
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-6 xl:gap-y-12">
        {INCLUDED_FEATURES.map((item, i) => (
          <div class="flex items-start gap-4 reveal" data-delay={String((i % 3) + 1)}>
            <div class="w-[44px] h-[44px] rounded-[12px] bg-[#eaf7ee] flex items-center justify-center flex-shrink-0">
              <svg
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#1fa84b"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={INCLUDED_FEATURE_ICON_PATHS[item.icon] ?? INCLUDED_FEATURE_ICON_PATHS.shield} />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-[1.05rem] font-semibold text-[#10243d] tracking-[-0.025em] mb-2">
                {item.title}
              </h3>
              <p class="text-[.90rem] leading-[1.75] text-[#516a88] max-w-[320px]">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Sales Form -->
  <section class="bg-[#eef2f7] py-20 md:py-24" id="contact-sales">
    <div class="container">
      <div class="text-center mb-12 md:mb-14">
        <div class="eyebrow-center reveal">Talk to Sales</div>
        <h2
          class="font-display font-bold text-[#0d2137] tracking-[-0.055em] leading-[1.02] mt-4 reveal"
          style="font-size:clamp(2.1rem,3.8vw,3.25rem)"
          data-delay="1"
        >
          Get a custom quote for your team
        </h2>
        <p
          class="text-[.98rem] text-[#516a88] max-w-[540px] mx-auto mt-4 leading-[1.72] reveal"
          data-delay="2"
        >
          Tell us about your operation and we'll put together a proposal that works for your guard count, region and requirements.
        </p>
      </div>
      <div
        class="max-w-[920px] mx-auto rounded-[24px] border border-[#d8e2ef] bg-white shadow-[0_24px_64px_rgba(13,33,55,.14)] overflow-hidden reveal"
      >
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
          <div
            class="bg-[#10243d] p-8 md:p-10 lg:p-12 text-white"
            style="background-image:radial-gradient(ellipse 80% 70% at 90% 100%,rgba(31,168,75,.14) 0%,transparent 60%)"
          >
            <h3 class="font-display text-[1.25rem] md:text-[1.4rem] font-bold text-white tracking-[-0.03em] mb-3 max-w-[260px]">
              Why companies choose PatrolPilot
            </h3>
            <p class="text-[.82rem] md:text-[.875rem] text-white/38 mb-8 leading-[1.65] max-w-[280px]">
              Trusted by 500+ security companies across the USA, Canada, UK, UAE and Singapore.
            </p>
            <div class="space-y-6">
              {SALES_HIGHLIGHTS.map((item) => (
                <div class="flex items-start gap-3">
                <div
                  class="w-[38px] h-[38px] rounded-[10px] flex-shrink-0 flex items-center justify-center bg-[#0b1d31] border border-[#1fa84b]/30"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#1fa84b"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={SALES_HIGHLIGHT_ICON_PATHS[item.icon] ?? SALES_HIGHLIGHT_ICON_PATHS.pricing} />
                  </svg>
                </div>
                <div>
                  <div class="font-mono text-[.53rem] tracking-[.22em] uppercase text-white/30 mb-1.5">
                    {item.title}
                  </div>
                  <div class="text-[.88rem] md:text-[.80rem] text-white/70 font-semibold leading-[1.45] max-w-[220px]">
                    {item.desc}
                  </div>
                </div>
              </div>
              ))}
            </div>
            <div class="mt-8 pt-7 border-t border-white/[0.08]">
              <div class="font-mono text-[.53rem] tracking-[.22em] uppercase text-white/30 mb-2.5">
                Compliance
              </div>
              <div class="flex flex-wrap gap-2.5">
                {["SOC 2 Type II", "ISO 27001", "GDPR - CCPA", "PDPA - UAE PDPL"].map((b) => (
                  <span class="inline-flex items-center rounded-[4px] border border-white/10 px-2.5 py-1 font-mono text-[.60rem] tracking-[.2em] uppercase text-white/55 bg-white/[0.03]">
                    {b}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="p-8 md:p-10 lg:p-11 bg-white">
            <h3 class="font-display text-[1.25rem] md:text-[1.3rem] font-bold text-[#0d2137] tracking-[-0.03em] mb-1.5">
              Request a custom quote
            </h3>
            <p class="text-[.875rem] text-[#4e647d] mb-7 max-w-[320px]">
              We'll respond within one business day with a tailored proposal.
            </p>
            <form class="space-y-4" onsubmit="return false">
              <div class="grid grid-cols-2 gap-3.5">
                <div class="form-field">
                  <label class="form-label">First Name *</label>
                  <input type="text" class="form-input" placeholder="Alex" />
                </div>
                <div class="form-field">
                  <label class="form-label">Last Name *</label>
                  <input type="text" class="form-input" placeholder="Johnson" />
                </div>
              </div>
              <div class="form-field">
                <label class="form-label">Work Email *</label>
                <input type="email" class="form-input" placeholder="alex@yourcompany.com" />
              </div>
              <div class="form-field">
                <label class="form-label">Company Name *</label>
                <input type="text" class="form-input" placeholder="Metro Security Services" />
              </div>
              <div class="grid grid-cols-2 gap-3.5">
                <div class="form-field">
                  <label class="form-label">Country *</label>
                  <select class="form-input">
                    <option value="">Select country...</option>
                    <option>United States</option>
                    <option>Canada</option>
                    <option>United Kingdom</option>
                    <option>UAE</option>
                    <option>Singapore</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="form-field">
                  <label class="form-label">Guards / Month *</label>
                  <select class="form-input">
                    <option value="">Select range...</option>
                    <option>1-25 guards</option>
                    <option>26-75 guards</option>
                    <option>76-200 guards</option>
                    <option>200+ guards</option>
                  </select>
                </div>
              </div>
              <div class="form-field">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-input" placeholder="+1 (555) 000-0000" />
              </div>
              <div class="form-field">
                <label class="form-label">Tell us about your operation</label>
                <textarea
                  class="form-input resize-y min-h-[80px] leading-relaxed"
                  rows="3"
                  placeholder="e.g. number of sites, current tools, key challenges..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white rounded-[10px]
                             bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c]
                             shadow-[0_6px_20px_rgba(31,168,75,.3)]
                             hover:brightness-110 hover:-translate-y-px transition-all"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send Enquiry
              </button>
              <p class="text-[.78rem] text-[#8599b0]">
                By submitting you agree to our <a href="/terms" class="text-[#1fa84b] hover:underline">Terms</a>
                and <a href="/privacy" class="text-[#1fa84b] hover:underline">Privacy Policy</a>.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-sm">
      <h2 class="font-display text-[1.8rem] font-bold text-[#0d2137] tracking-[-0.04em] text-center mb-8 reveal">
        Pricing FAQs
      </h2>
      <div class="space-y-2">
        {[
          [
            "How is the licence tier calculated?",
            "Your tier is based on the maximum number of guards you schedule in any single month during the licence period. We look at peak usage, not averages.",
          ],
          [
            "Is there a free trial?",
            "Yes. All tiers come with a 14-day free trial with full platform access - no credit card required.",
          ],
          [
            "What happens if I exceed my guard tier mid-year?",
            "We'll contact you proactively if you're trending over your tier. You can upgrade at any time and we'll prorate the difference.",
          ],
          [
            "Are all features included in every tier?",
            "Yes. Every tier includes GPS tracking, NFC checkpoints, scheduling, licence compliance, incident reports, SOS alerts, the guard mobile app and analytics.",
          ],
          [
            "Can I pay monthly instead of annually?",
            "Annual licences give you the best rate. Monthly billing is available at a 20% premium.",
          ],
          [
            "Do you offer discounts for multi-year contracts?",
            "Yes. Two and three-year agreements come with discounts of 10% and 15% respectively.",
          ],
        ].map(([q, a], i) => (
          <details
            class="border border-[#d8e2ef] rounded-[10px] overflow-hidden hover:border-[rgba(31,168,75,.28)] transition-colors reveal"
            data-delay={String((i % 3) + 1)}
          >
            <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-display text-[.95rem] font-semibold text-[#0d2137] hover:bg-[#f3f6fb] select-none list-none [&::-webkit-details-marker]:hidden">
              {q}
              <span class="text-[1.2rem] text-[#1fa84b] flex-shrink-0 font-mono transition-transform duration-200 details-arrow">
                +
              </span>
            </summary>
            <div class="px-5 pb-4 text-[.875rem] text-[#4e647d] leading-[1.72]">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

