---
/**
 * pricing.astro
 * Single price entry + contact sales form
 * Content can be overridden via WordPress ACF options page
 */
import Layout from '@/layouts/Layout.astro';
import { PRICING } from '@/lib/config';
---

<Layout
  title="Pricing"
  description="PatrolPilot pricing — licence tiers starting from $3,500 per annum based on guards scheduled. Contact our team to find the right deal."
>

  <!-- Hero -->
  <section class="bg-[#0d2137] pt-[140px] pb-24 relative overflow-hidden text-center">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 70% 80% at 50% 60%,rgba(31,168,75,.12) 0%,transparent 65%)"></div>
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:60px 60px;mask-image:linear-gradient(0deg,transparent 0%,#000 30%,#000 70%,transparent 100%)"></div>
    <div class="container relative z-10">
      <div class="eyebrow-center animate-fade-up">Simple Pricing</div>
      <h1 class="font-display font-bold text-white tracking-[-0.055em] leading-[.94] mt-4 mb-5 animate-fade-up"
          style="font-size:clamp(2.8rem,5vw,4.4rem);animation-delay:.1s">
        Let's find a deal that
        <span class="block" style="background:linear-gradient(135deg,#2dd65a,#1fa84b,#148036);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
          works for you.
        </span>
      </h1>
      <p class="text-[1.1rem] text-white/40 max-w-[560px] mx-auto mb-8 leading-[1.72] font-light animate-fade-up" style="animation-delay:.2s">
        Licence tiers start at <strong class="text-white font-semibold">$3,500 per annum</strong>,
        and are based on the number of guards you schedule each month. No hidden fees. No lock-in.
      </p>
      <!-- Starting price anchor pill -->
      <div class="inline-flex items-center gap-0 bg-white/[0.06] border border-white/10 rounded-[20px] p-1.5 backdrop-blur-lg mb-8 animate-fade-up" style="animation-delay:.3s">
        <span class="font-mono text-[.6rem] tracking-[.2em] uppercase text-white/40 px-4 py-2">Starting from</span>
        <span class="bg-[#1fa84b] rounded-[14px] px-5 py-2.5 font-display text-[1rem] font-bold text-white tracking-[-0.02em]">
          $3,500 / year
        </span>
      </div>
      <div class="flex items-center justify-center gap-3 flex-wrap animate-fade-up" style="animation-delay:.4s">
        {["No setup fees","14-day free trial","Cancel anytime","Region hosted"].map(t => (
          <span class="trust-badge">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Tier cards -->
  <section class="section bg-[#f3f6fb]">
    <div class="container">
      <div class="text-center mb-12">
        <div class="eyebrow-center reveal">Guard-Based Tiers</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.04em] leading-[1.04] mt-3.5 reveal"
            style="font-size:clamp(1.8rem,3vw,2.6rem)" data-delay="1">
          Pricing based on guards scheduled per month
        </h2>
        <p class="text-[.95rem] text-[#4e647d] max-w-[520px] mx-auto mt-3 leading-[1.7] reveal" data-delay="2">
          Every tier includes the full platform. GPS tracking, NFC checkpoints, scheduling, compliance,
          incident reports and the guard mobile app.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {PRICING.tiers.map((tier, i) => (
          <div class:list={[
            "bg-white rounded-[16px] border p-6 relative overflow-hidden group",
            "hover:border-[rgba(31,168,75,.25)] hover:shadow-[0_8px_32px_rgba(13,33,55,.1)] hover:-translate-y-1",
            "transition-all duration-[.24s] reveal",
            tier.popular ? "border-[#1fa84b] shadow-[0,0,0,1px,#1fa84b]" : "border-[#d8e2ef]",
          ]} data-delay={String(i+1)}>
            <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#1fa84b] to-[#178a3c] scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-[.35s]"></div>
            {tier.popular && (
              <div class="absolute top-4 right-4 bg-gradient-to-br from-[#1fa84b] to-[#178a3c] text-white font-mono text-[.52rem] tracking-[.18em] uppercase px-2.5 py-1 rounded">
                Popular
              </div>
            )}
            <div class="font-mono text-[.58rem] tracking-[.22em] uppercase text-[#8599b0] mb-2.5">
              {tier.guards ? `Up to ${tier.guards} guards / mo` : '200+ guards / mo'}
            </div>
            <div class="font-display font-bold tracking-[-0.05em] leading-none mb-1"
                 style={`font-size:2rem;color:${tier.popular?'#1fa84b':'#0d2137'}`}>
              {tier.price ? `$${tier.price.toLocaleString()}` : 'Custom'}
              {tier.price && <span class="text-base font-medium text-[#4e647d]">/yr</span>}
            </div>
            {tier.monthly && (
              <div class="font-mono text-[.57rem] tracking-[.14em] uppercase text-[#8599b0] mb-4">
                ~ ${tier.monthly.toLocaleString()} per month
              </div>
            )}
            <div class="h-px bg-[#d8e2ef] mb-4"></div>
            <ul class="space-y-2">
              {["Full platform access","GPS + NFC checkpoints","Guard mobile app","Scheduling & compliance",
                i>=1?"Client patrol portal":null,i>=1?"Payroll integration":null,
                i>=2?"Dedicated account manager":null,i>=3?"Unlimited guards & sites":null,
                i>=3?"Custom API & integrations":null,
              ].filter(Boolean).map(feat => (
                <li class="flex items-start gap-2 text-[.82rem] text-[#4e647d]">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.5" class="flex-shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center font-mono text-[.6rem] tracking-[.16em] uppercase text-[#8599b0] mt-6">
        Not sure which tier fits? Fill in the form below — we'll work it out together.
      </p>
    </div>
  </section>

  <!-- Contact Sales Form -->
  <section class="section bg-white" id="contact-sales">
    <div class="container">
      <div class="text-center mb-12">
        <div class="eyebrow-center reveal">Talk to Sales</div>
        <h2 class="font-display font-bold text-[#0d2137] tracking-[-0.045em] leading-[1.04] mt-3.5 reveal"
            style="font-size:clamp(1.8rem,3vw,2.8rem)" data-delay="1">
          Get a custom quote for your team
        </h2>
        <p class="text-[.95rem] text-[#4e647d] max-w-[500px] mx-auto mt-3 leading-[1.7] reveal" data-delay="2">
          Tell us about your operation and we'll put together a proposal that works for your guard count, region and requirements.
        </p>
      </div>
      <div class="max-w-[900px] mx-auto rounded-[24px] border border-[#d8e2ef] shadow-[0_24px_64px_rgba(13,33,55,.18)] overflow-hidden reveal">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
          <!-- Left: Why PatrolPilot -->
          <div class="bg-[#0d2137] p-12" style="background-image:radial-gradient(ellipse 80% 70% at 90% 100%,rgba(31,168,75,.15) 0%,transparent 60%)">
            <h3 class="font-display text-[1.4rem] font-bold text-white tracking-[-0.03em] mb-2">Why companies choose PatrolPilot</h3>
            <p class="text-[.875rem] text-white/40 mb-8 leading-[1.65]">Trusted by 500+ security companies across the USA, Canada, UK, UAE and Singapore.</p>
            {[
              {icon:"M20 6 9 17l-5-5",title:"Transparent Pricing",desc:"Starting from $3,500/yr — no hidden fees"},
              {icon:"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",title:"Full Platform Included",desc:"GPS, NFC, scheduling, compliance, mobile app"},
              {icon:"M12 2a7 7 0 017 7c0 5-7 13-7 13S5 14 5 9a7 7 0 017-7z",title:"Regional Support",desc:"Local teams in USA, UK, UAE & Singapore"},
              {icon:"M5 3l14 9-14 9V3z",title:"Fast Onboarding",desc:"Up and running within 48 hours"},
            ].map(item => (
              <div class="flex items-start gap-3 mb-6 last:mb-0">
                <div class="w-[38px] h-[38px] rounded-[9px] flex-shrink-0 flex items-center justify-center" style="background:rgba(31,168,75,.15);border:1px solid rgba(31,168,75,.25)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2.5"><polyline points={item.icon}/></svg>
                </div>
                <div>
                  <div class="font-mono text-[.55rem] tracking-[.2em] uppercase text-white/30 mb-1">{item.title}</div>
                  <div class="text-[.9rem] text-white/75 font-medium">{item.desc}</div>
                </div>
              </div>
            ))}
            <div class="mt-8 pt-7 border-t border-white/[0.08]">
              <div class="font-mono text-[.55rem] tracking-[.2em] uppercase text-white/30 mb-2.5">Compliance</div>
              <div class="flex flex-wrap gap-1.5">
                {["SOC 2 Type II","ISO 27001","GDPR · CCPA","PDPA · UAE PDPL"].map(b => (
                  <span class="sec-badge sec-badge--navy text-[.5rem]">{b}</span>
                ))}
              </div>
            </div>
          </div>
          <!-- Right: Form -->
          <div class="p-10">
            <h3 class="font-display text-[1.3rem] font-bold text-[#0d2137] tracking-[-0.03em] mb-1.5">Request a custom quote</h3>
            <p class="text-[.875rem] text-[#4e647d] mb-7">We'll respond within one business day with a tailored proposal.</p>
            <form class="space-y-4" onsubmit="return false">
              <div class="grid grid-cols-2 gap-3.5">
                <div class="form-field">
                  <label class="form-label">First Name *</label>
                  <input type="text" class="form-input" placeholder="Alex"/>
                </div>
                <div class="form-field">
                  <label class="form-label">Last Name *</label>
                  <input type="text" class="form-input" placeholder="Johnson"/>
                </div>
              </div>
              <div class="form-field">
                <label class="form-label">Work Email *</label>
                <input type="email" class="form-input" placeholder="alex@yourcompany.com"/>
              </div>
              <div class="form-field">
                <label class="form-label">Company Name *</label>
                <input type="text" class="form-input" placeholder="Metro Security Services"/>
              </div>
              <div class="grid grid-cols-2 gap-3.5">
                <div class="form-field">
                  <label class="form-label">Country *</label>
                  <select class="form-input">
                    <option value="">Select country...</option>
                    <option>🇺🇸 United States</option>
                    <option>🇨🇦 Canada</option>
                    <option>🇬🇧 United Kingdom</option>
                    <option>🇦🇪 UAE</option>
                    <option>🇸🇬 Singapore</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="form-field">
                  <label class="form-label">Guards / Month *</label>
                  <select class="form-input">
                    <option value="">Select range...</option>
                    <option>1–25 guards</option>
                    <option>26–75 guards</option>
                    <option>76–200 guards</option>
                    <option>200+ guards</option>
                  </select>
                </div>
              </div>
              <div class="form-field">
                <label class="form-label">Phone</label>
                <input type="tel" class="form-input" placeholder="+1 (555) 000-0000"/>
              </div>
              <div class="form-field">
                <label class="form-label">Tell us about your operation</label>
                <textarea class="form-input resize-y min-h-[80px] leading-relaxed" rows="3" placeholder="e.g. number of sites, current tools, key challenges..."></textarea>
              </div>
              <button type="submit"
                      class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white rounded-[10px]
                             bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c]
                             shadow-[0_6px_20px_rgba(31,168,75,.3)]
                             hover:brightness-110 hover:-translate-y-px transition-all">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Send Enquiry
              </button>
              <p class="text-[.78rem] text-[#8599b0]">
                By submitting you agree to our <a href="/terms" class="text-[#1fa84b] hover:underline">Terms</a> and <a href="/privacy" class="text-[#1fa84b] hover:underline">Privacy Policy</a>.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-[#f3f6fb]">
    <div class="container-sm">
      <h2 class="font-display text-[1.8rem] font-bold text-[#0d2137] tracking-[-0.04em] text-center mb-8 reveal">Pricing FAQs</h2>
      <div class="space-y-2">
        {[
          ["How is the licence tier calculated?","Your tier is based on the maximum number of guards you schedule in any single month during the licence period. We look at peak usage, not averages."],
          ["Is there a free trial?","Yes. All tiers come with a 14-day free trial with full platform access — no credit card required."],
          ["What happens if I exceed my guard tier mid-year?","We'll contact you proactively if you're trending over your tier. You can upgrade at any time and we'll prorate the difference."],
          ["Are all features included in every tier?","Yes. Every tier includes GPS tracking, NFC checkpoints, scheduling, licence compliance, incident reports, SOS alerts, the guard mobile app and analytics."],
          ["Can I pay monthly instead of annually?","Annual licences give you the best rate. Monthly billing is available at a 20% premium."],
          ["Do you offer discounts for multi-year contracts?","Yes. Two and three-year agreements come with discounts of 10% and 15% respectively."],
        ].map(([q, a], i) => (
          <details class="border border-[#d8e2ef] rounded-[10px] overflow-hidden hover:border-[rgba(31,168,75,.28)] transition-colors reveal" data-delay={String((i%3)+1)}>
            <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-display text-[.95rem] font-semibold text-[#0d2137] hover:bg-[#f3f6fb] select-none list-none [&::-webkit-details-marker]:hidden">
              {q}
              <span class="text-[1.2rem] text-[#1fa84b] flex-shrink-0 font-mono transition-transform duration-200 details-arrow">+</span>
            </summary>
            <div class="px-5 pb-4 text-[.875rem] text-[#4e647d] leading-[1.72]">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .form-label { font-family:'Space Mono',monospace;font-size:.57rem;letter-spacing:.22em;text-transform:uppercase;color:#1a3a60;display:block;margin-bottom:6px }
  .form-input { width:100%;padding:11px 14px;background:#f3f6fb;border:1.5px solid #d8e2ef;border-radius:10px;font-size:.9rem;color:#0a1628;font-family:'Outfit',sans-serif;outline:none;transition:border-color .22s,box-shadow .22s,background .22s }
  .form-input:focus { border-color:#1fa84b;box-shadow:0 0 0 3px rgba(31,168,75,.1);background:#fff }
  .form-input::placeholder { color:#8599b0 }
  .form-field { display:flex;flex-direction:column }
  details[open] .details-arrow { transform:rotate(45deg) }
</style>
