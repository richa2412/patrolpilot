---
/**
 * contact.astro
 */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import FormStyles from '@/components/FormStyles.astro';
---

<Layout
  title="Contact PatrolPilot"
  description="Get in touch with the PatrolPilot team for demos, support or enterprise enquiries. Local teams in USA, UK, UAE and Singapore."
>
  <FormStyles />

  <PageHero
    eyebrow="Get in Touch"
    title="We'd love to hear"
    titleEm="from you."
    sub="Whether you're evaluating PatrolPilot, need support, or want to discuss enterprise requirements — our regional team is ready to help."
  >
    <div class="mt-6">
      <a href="/request-demo" class="inline-flex items-center gap-2 px-7 py-3.5 font-display text-[.9rem] font-semibold text-white rounded-[10px] bg-gradient-to-br from-[#24c455] via-[#1fa84b] to-[#178a3c] shadow-[0_6px_20px_rgba(31,168,75,.3)] hover:brightness-110 hover:-translate-y-px transition-all">Book a Demo</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Form -->
        <div class="reveal reveal-l">
          <h2 class="font-display text-[1.8rem] font-bold text-[#0d2137] tracking-[-0.04em] mb-6">Send us a message</h2>
          <form class="space-y-[18px]" onsubmit="return false">
            <div class="form-grid-2">
              <div class="form-field">
                <label class="form-label">First Name <span class="form-req">*</span></label>
                <input type="text" class="form-input" placeholder="Alex" />
              </div>
              <div class="form-field">
                <label class="form-label">Last Name <span class="form-req">*</span></label>
                <input type="text" class="form-input" placeholder="Johnson" />
              </div>
            </div>
            <div class="form-field">
              <label class="form-label">Email <span class="form-req">*</span></label>
              <input type="email" class="form-input" placeholder="alex@yourcompany.com" />
            </div>
            <div class="form-field">
              <label class="form-label">Company</label>
              <input type="text" class="form-input" placeholder="Metro Security Services" />
            </div>
            <div class="form-field">
              <label class="form-label">Subject</label>
              <select class="form-input">
                <option>General Enquiry</option>
                <option>Book a Demo</option>
                <option>Technical Support</option>
                <option>Enterprise Sales</option>
                <option>Billing &amp; Accounts</option>
              </select>
            </div>
            <div class="form-field">
              <label class="form-label">Message <span class="form-req">*</span></label>
              <textarea class="form-textarea" placeholder="Tell us how we can help..." rows="4"></textarea>
            </div>
            <button type="submit" class="btn-submit">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact details -->
        <div class="reveal reveal-r" data-delay="1">
          <h2 class="font-display text-[1.8rem] font-bold text-[#0d2137] tracking-[-0.04em] mb-6">Contact details</h2>
          <div class="space-y-4 mb-6">
            {[
              { icon: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81', label:'Phone', value:'+1 888 000 0000 (USA/Canada)\n+44 20 0000 0000 (UK)', mono:'Mon–Fri 9AM–6PM your local time' },
              { icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6', label:'Email', value:'hello@patrolpilot.com', mono:'Response within 4 hours' },
              { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z', label:'Regions', value:'USA · Canada · UK · UAE · Singapore', mono:'Regional support teams' },
            ].map(c => (
              <div class="flex items-start gap-3.5 p-5 bg-[#f3f6fb] rounded-[14px] border border-[#d8e2ef]">
                <div class="w-[40px] h-[40px] rounded-[10px] bg-[#e8f8ee] flex items-center justify-center flex-shrink-0">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1fa84b" stroke-width="2"><path d={c.icon}/></svg>
                </div>
                <div>
                  <div class="font-display text-[.9rem] font-semibold text-[#0d2137] mb-1">{c.label}</div>
                  <div class="text-[.875rem] text-[#4e647d] whitespace-pre-line leading-relaxed">{c.value}</div>
                  <div class="font-mono text-[.56rem] tracking-[.12em] uppercase text-[#8599b0] mt-1">{c.mono}</div>
                </div>
              </div>
            ))}
          </div>

          <!-- System status -->
          <div class="p-5 bg-[#0d2137] rounded-[14px]">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-2 h-2 rounded-full bg-[#1fa84b]" style="animation:dotPulse 2s ease infinite"></div>
              <span class="font-mono text-[.58rem] tracking-[.18em] uppercase text-white/50">SUPPORT STATUS</span>
            </div>
            <div class="font-display text-[1rem] font-semibold text-white">All systems operational</div>
            <div class="text-[.84rem] text-white/40 mt-1">Last checked 2 minutes ago</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
