---
import SolutionPage from '@/components/SolutionPage.astro';
---

<SolutionPage
  metaTitle="Security Guard Scheduling Software | USA, Canada, UK, UAE, Singapore | PatrolPilot"
  metaDesc="Build security guard rosters in minutes. Automatic licence checks, overtime alerts and instant guard notifications. Serving the USA, Canada, UK, UAE and Singapore."
  eyebrow="Guard Scheduling"
  heroTitle="Security Guard Scheduling Software"
  heroEm="That actually works."
  heroSub="Build rosters in minutes, not hours. PatrolPilot automatically checks licences, prevents overtime conflicts and notifies guards instantly."
  intro="Manual roster building is one of the biggest time drains for security operations managers. PatrolPilot's scheduling module automates the hard parts — licence checks, conflict detection, and guard notifications — so you can build a week's schedule in minutes instead of hours. Used by security companies across the USA, Canada, UK, UAE and Singapore."
  features={[
    {
      title: 'Drag-and-Drop Roster',
      desc: 'Build shifts visually with drag-and-drop. Assign guards to sites and shifts with a single click. Colour-coded by site, shift type or guard.',
      icon: 'M3 4h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V6a2 2 0 012-2z',
    },
    {
      title: 'Licence Compliance Checks',
      desc: 'Automatically validates that every guard scheduled has a valid, current security licence and required certifications before confirming the shift.',
      icon: 'M22 11.08V12a10 10 0 11-5.93-9.14M22 4L12 14.01l-3-3',
    },
    {
      title: 'Instant Guard Notifications',
      desc: 'Guards receive push notifications the moment they\'re rostered, with shift details, site address and reporting instructions.',
      icon: 'M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0',
    },
    {
      title: 'Shift Swaps & Cover',
      desc: 'Guards request shift swaps directly in the app. Managers approve with one tap. Automatic conflict and licence checking throughout.',
      icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
    },
    {
      title: 'Overtime & Availability Rules',
      desc: 'Set maximum hours, minimum rest periods and availability windows. The scheduler flags and prevents rule violations automatically.',
      icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    },
    {
      title: 'Multi-Site Management',
      desc: 'Schedule across unlimited sites from one view. Filter by site, guard, shift type or date range. Copy weekly rosters in one click.',
      icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z',
    },
  ]}
  faqs={[
    {
      q: 'Can guards view their schedules on their phone?',
      a: 'Yes. Guards download the free PatrolPilot mobile app and see their upcoming shifts, site details and any schedule changes in real time. Push notifications are sent for any changes.',
    },
    {
      q: 'Does the scheduler check licence expiry automatically?',
      a: 'Yes. Every time you schedule a guard, PatrolPilot checks their licence validity. Guards with expired or expiring licences are flagged and cannot be scheduled until their licence is renewed.',
    },
    {
      q: 'Can I copy a weekly schedule to the next week?',
      a: 'Yes. You can duplicate any week\'s schedule and make adjustments, saving significant time on repetitive rosters.',
    },
    {
      q: 'Does the scheduling software handle multiple time zones?',
      a: 'Yes. PatrolPilot supports multiple time zones, making it ideal for security companies with operations across different regions or countries.',
    },
  ]}
/>
