---
/**
 * PageHero.astro
 * Dark navy hero used on all inner pages (features, about, contact, etc.)
 */
interface Props {
  eyebrow: string;
  title: string;
  titleEm?: string;
  sub?: string;
  center?: boolean;
}

const { eyebrow, title, titleEm, sub, center = false } = Astro.props;
---

<section class="bg-[#0d2137] pt-[140px] pb-20 relative overflow-hidden">
  <div
    class="absolute inset-0"
    style="background:radial-gradient(ellipse 70% 60% at 65% 50%,rgba(31,168,75,.09) 0%,transparent 65%),radial-gradient(ellipse 50% 80% at 5% 50%,rgba(26,58,96,.5) 0%,transparent 60%)"
  ></div>
  <div
    class="absolute inset-0"
    style="background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:60px 60px;mask-image:linear-gradient(0deg,transparent 0%,#000 30%,#000 70%,transparent 100%)"
  ></div>

  <div class:list={["container relative z-10", center && "text-center"]}>
    <div class:list={["eyebrow eyebrow--light animate-fade-up", center && "eyebrow-center justify-center"]}>{eyebrow}</div>
    <h1
      class="font-display font-bold text-white tracking-[-0.05em] leading-[.96] mt-4 mb-5 animate-fade-up"
      style="font-size:clamp(2.6rem,5vw,4.2rem);animation-delay:.1s"
    >
      {title}
      {titleEm && (
        <span
          class="block"
          style="background:linear-gradient(135deg,#2dd65a,#1fa84b,#148036);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"
        >
          {titleEm}
        </span>
      )}
    </h1>
    {sub && (
      <p class="text-[1.05rem] text-white/44 max-w-[520px] leading-[1.74] font-light animate-fade-up" style="animation-delay:.2s">
        {sub}
      </p>
    )}
    <div class="animate-fade-up" style="animation-delay:.3s">
      <slot />
    </div>
  </div>
</section>
