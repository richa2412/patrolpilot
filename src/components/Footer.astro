---
import { SITE, COMPLIANCE_BADGES } from "@/lib/config";

interface Props {
  prefix?: string;
}
const { prefix = "" } = Astro.props;
---

<footer
  class="bg-[#0d2137] pt-20 pb-9 text-white/40"
  style="background-image: radial-gradient(ellipse 60% 50% at 20% 85%, rgba(31,168,75,.06) 0%, transparent 60%)"
>
  <div class="container mx-auto px-6">
    <!-- Top: brand + newsletter -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-16 pb-14 border-b border-white/[0.07] mb-14"
    >
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div
            class="w-[52px] h-[52px] rounded-xl bg-white overflow-hidden flex-shrink-0
                      shadow-[0_3px_14px_rgba(0,0,0,.28)] flex items-center justify-center"
          >
            <img
              src={SITE.logo}
              alt={SITE.name}
              width="48"
              height="48"
              class="w-12 h-12 object-cover"
            />
          </div>
          <div>
            <div
              class="font-display text-[18px] font-bold text-white tracking-tight"
            >
              Patrol<span class="text-[#1fa84b]">Pilot</span>
            </div>
            <div
              class="font-mono text-[8px] tracking-[.26em] uppercase text-white/25 mt-0.5"
            >
              Security Management Platform
            </div>
          </div>
        </div>
        <p class="text-sm text-white/30 max-w-sm mb-5 leading-relaxed">
          Security guard management software for the USA, Canada, UK, UAE and
          Singapore. One platform. Every region. GPS tracking, NFC checkpoints,
          scheduling and compliance — all in one place.
        </p>
        <div class="flex gap-2">
          <a
            href={SITE.social.linkedin}
            class="footer-social"
            aria-label="LinkedIn"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"
              ></path>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href={SITE.social.facebook}
            class="footer-social"
            aria-label="Facebook"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
      <div>
        <p
          class="font-mono text-[.57rem] tracking-[.22em] uppercase text-white/25 mb-3"
        >
          Stay Updated
        </p>
        <p class="text-sm text-white/30 mb-4">
          Security insights and product updates straight to your inbox.
        </p>
        <form class="flex gap-2" onsubmit="return false">
          <input
            type="email"
            placeholder="your@company.com"
            class="flex-1 px-3.5 py-2.5 bg-white/[0.06] border border-white/10 rounded-[9px]
                   text-white text-sm outline-none placeholder-white/20
                   focus:border-[#1fa84b] focus:bg-white/[0.09] transition-colors"
          />
          <button
            type="submit"
            class="px-4 py-2.5 bg-[#1fa84b] text-white font-display text-sm font-semibold
                   rounded-[9px] whitespace-nowrap hover:bg-[#178a3c] hover:-translate-y-px transition-all"
          >
            Subscribe
          </button>
        </form>
        <div class="flex flex-wrap gap-2 mt-4">
          {
            COMPLIANCE_BADGES.slice(0, 3).map((b) => (
              <span class="sec-badge sec-badge--navy">{b}</span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-10 pb-12 border-b border-white/[0.07] mb-8"
    >
      <div>
        <p
          class="font-mono text-[.54rem] tracking-[.3em] uppercase text-white/18 mb-[18px]"
        >
          Product
        </p>
        <ul class="space-y-2.5 list-none">
          <li><a href="/features" class="footer-link">All Features</a></li>
          <li><a href="/pricing" class="footer-link">Pricing</a></li>
          <li><a href="/how-it-works" class="footer-link">How It Works</a></li>
          <li><a href="/request-demo" class="footer-link">Request Demo</a></li>
        <li><a href="/mobile-patrol-app" class="footer-link">Mobile App</a> </li>
        </ul>
      </div>
      <div>
        <p
          class="font-mono text-[.54rem] tracking-[.3em] uppercase text-white/18 mb-[18px]"
        >
          Solutions
        </p>
        <ul class="space-y-2.5 list-none">
          <li>
            <a href="/security-guard-management-software" class="footer-link"
              >Guard Management</a>
          </li>
          <li>
            <a href="/security-guard-scheduling-software" class="footer-link"
              >Scheduling</a>
          </li>
          <li>
            <a href="/guard-tour-software" class="footer-link">Guard Tours</a>
          </li>
          <li>
            <a href="/mobile-patrol-app" class="footer-link">Mobile App</a>
          </li>
        </ul>
      </div>
      <div>
        <p
          class="font-mono text-[.54rem] tracking-[.3em] uppercase text-white/18 mb-[18px]"
        >
          Account
        </p>
        <ul class="space-y-2.5 list-none">
          <li><a href="/login" class="footer-link">Log In</a></li>
          <li><a href="/signup" class="footer-link">Sign Up</a></li>
          <li>
            <a href="/forgot-password" class="footer-link">Reset Password</a>
          </li>
        </ul>
      </div>
      <div>
        <p
          class="font-mono text-[.54rem] tracking-[.3em] uppercase text-white/18 mb-[18px]"
        >
          Legal
        </p>
        <ul class="space-y-2.5 list-none">
          <li>
            <a href="/terms" class="footer-link">Terms &amp; Conditions</a>
          </li>
          <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
          <li><a href="/cookies" class="footer-link">Cookie Policy</a></li>
          <li><a href="/contact" class="footer-link">Contact</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-white/20"
    >
      <div class="flex items-center gap-4 flex-wrap">
        <span>© 2025 Engage Workforce Ltd. All rights reserved.</span>
        <a
          href="/privacy"
          class="text-white/25 hover:text-white/70 transition-colors">Privacy</a
        >
        <a
          href="/terms"
          class="text-white/25 hover:text-white/70 transition-colors">Terms</a
        >
      </div>
      <div class="flex gap-1.5 flex-wrap">
        {
          COMPLIANCE_BADGES.map((b) => (
            <span class="px-2.5 py-1 border border-white/10 rounded text-[.6rem] font-mono tracking-[.08em] text-white/25">
              {b}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    @apply w-9 h-9 rounded-[9px] border border-white/10 flex items-center justify-center
           text-white/30 transition-all duration-200
           hover:border-[#1fa84b] hover:text-[#1fa84b] hover:bg-[rgba(31,168,75,.1)] hover:-translate-y-px;
  }
  .footer-link {
    @apply text-sm text-white/40 hover:text-white transition-colors duration-200;
  }
</style>
