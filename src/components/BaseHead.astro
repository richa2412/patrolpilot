---
/**
 * BaseHead.astro
 * SEO meta tags, Open Graph, JSON-LD schema, fonts
 * WordPress Yoast SEO data is passed via `seo` prop when available
 */
import type { YoastSEO } from '@/lib/wordpress';
import { SITE } from '@/lib/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  seo?: YoastSEO;
  type?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  author?: string;
}

const {
  title: propTitle,
  description: propDesc,
  image: propImage,
  canonicalUrl,
  seo,
  type = 'website',
  publishDate,
  modifiedDate,
  author,
} = Astro.props;

// Priority: Yoast SEO > props > defaults
const title       = seo?.title || (propTitle ? `${propTitle} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`);
const description = seo?.description || propDesc || SITE.description;
const image       = seo?.og_image?.[0]?.url || propImage || `${SITE.url}/og-default.png`;
const canonical   = seo?.canonical || canonicalUrl || Astro.url.href;

// JSON-LD Organisation schema
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  description: SITE.description,
  url: SITE.url,
  logo: `${SITE.url}${SITE.logo}`,
  sameAs: Object.values(SITE.social),
  offers: {
    '@type': 'Offer',
    price: '3500',
    priceCurrency: 'USD',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: 3500, priceCurrency: 'USD', unitText: 'ANN' },
  },
};

const articleSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image,
  author: { '@type': 'Person', name: author || SITE.name },
  datePublished: publishDate,
  dateModified: modifiedDate || publishDate,
  publisher: { '@type': 'Organization', name: SITE.name, logo: `${SITE.url}${SITE.logo}` },
} : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={`${seo?.robots?.index || 'index'}, ${seo?.robots?.follow || 'follow'}`} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={seo?.og_title || title} />
<meta property="og:description" content={seo?.og_description || description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(seo?.og_image?.[0]?.width || 1200)} />
<meta property="og:image:height" content={String(seo?.og_image?.[0]?.height || 630)} />
<meta property="og:url" content={canonical} />
{publishDate && <meta property="article:published_time" content={publishDate} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@patrolpilot" />
<meta name="twitter:title" content={seo?.og_title || title} />
<meta name="twitter:description" content={seo?.og_description || description} />
<meta name="twitter:image" content={image} />

<!-- Favicons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0d2137" />

<!-- Preconnect for Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- JSON-LD Schema -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
