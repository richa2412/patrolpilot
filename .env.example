# PatrolPilot Astro — Environment Variables
# Copy to .env and fill in your values

# ─── WordPress CMS ────────────────────────────────────────────────────────────
# Your WordPress installation URL (no trailing slash)
WP_API_URL=https://cms.patrolpilot.com

# Optional JWT token for protected WordPress REST API endpoints
# Generate via POST /wp-json/jwt-auth/v1/token with admin credentials
# WP_JWT_TOKEN=your-jwt-token-here

# ─── Frontend ─────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://patrolpilot.com

# ─── Build / Deploy ───────────────────────────────────────────────────────────
# Set to 'production' for production builds
NODE_ENV=development
